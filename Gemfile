source "https://rubygems.org"

# Matches the exact Jekyll + plugin versions GitHub Pages uses,
# so the local preview looks the same as the live site.
# GitHub Pages runs Ruby 3.3, so use Ruby 3.3 locally (see README).
gem "github-pages", group: :jekyll_plugins

# Needed to run `jekyll serve` on Ruby 3+
gem "webrick"

# No longer bundled with newer Ruby versions, but Jekyll 3 still needs them
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
